msgstr "Too many uploads in a row. Try again in a few minutes."

msgid "Comprovante recebido. Vamos conferir o pagamento e avisar você."
msgstr "Proof received. We'll check the payment and let you know."

msgid "Dados para o pagamento do pedido %(number)s — JD PRINT"
msgstr "Payment details for order %(number)s — JD PRINT"

