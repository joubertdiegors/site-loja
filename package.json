{
  "name": "jdprint-frontend",
  "version": "1.0.0",
  "private": true,
  "description": "Build do Tailwind CSS para os templates Django da JD PRINT.",
  "scripts": {
    "build:css": "tailwindcss -i ./static/src/input.css -o ./static/css/tailwind.css --minify",
    "watch:css": "tailwindcss -i ./static/src/input.css -o ./static/css/tailwind.css --watch"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.11",
    "tailwindcss": "^4.1.11"
  }
}
