# ---------------------------------------------------------------------------
# JD PRINT - variáveis de ambiente
# Copie este arquivo para `.env` e ajuste os valores.
# ---------------------------------------------------------------------------

DJANGO_SECRET_KEY=troque-esta-chave
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Origens confiaveis para CSRF. Obrigatorio com HTTPS em producao, com esquema:
#   DJANGO_CSRF_TRUSTED_ORIGINS=https://jdprint.pythonanywhere.com
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_TIME_ZONE=Europe/Brussels
DJANGO_LANGUAGE_CODE=pt-br

# Banco de dados oficial do projeto: PostgreSQL.
#
# ATENCAO: os valores abaixo sao a convencao de DESENVOLVIMENTO LOCAL descrita
# no README (banco em 127.0.0.1, criado por voce na sua maquina). NAO sao um
# segredo e NAO servem para producao: no servidor, estes campos recebem as
# credenciais reais e o arquivo `.env` nunca e versionado.
# Use DJANGO_DB_ENGINE=sqlite APENAS enquanto o PostgreSQL não estiver
# instalado na máquina de desenvolvimento.
DJANGO_DB_ENGINE=postgres
POSTGRES_DB=jdprint
POSTGRES_USER=jdprint
POSTGRES_PASSWORD=jdprint
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
# Segundos que uma conexao com o banco fica reaproveitada entre requisicoes.
# 0 abre e fecha a cada requisicao; em hospedagem compartilhada, valores altos
# gastam as conexoes disponiveis do servidor.
POSTGRES_CONN_MAX_AGE=60

# Upload máximo por arquivo de mídia (bytes). 50 MB por padrão.
PRODUCT_MEDIA_MAX_UPLOAD_SIZE=52428800

# Loja
SHOP_MODELS_CATEGORY_SLUG=modelos
SHOP_PAGE_SIZE=12
SHOP_PAGE_SIZE_OPTIONS=4,8,12,16,20,24
CART_MAX_QUANTITY_PER_LINE=99

# Personalização enviada pelo cliente
CUSTOMIZATION_MAX_UPLOAD_SIZE=10485760
CUSTOMIZATION_NOTES_MAX_LENGTH=500

# ---------------------------------------------------------------------------
# E-mail
#
# PRIORIDADE (ver apps/core/mailer.py e docs/OPERACAO.md):
#
#     configuracao do Admin (Core > configuracao de e-mail), ativa e com
#     servidor preenchido
#         v  se nao houver
#     as variaveis abaixo
#
# Enquanto ninguem cadastrar a configuracao no Admin, e daqui que sai tudo.
# A senha e um SEGREDO: preencha no `.env` do servidor, nunca no `.env.example`
# e nunca no codigo.
# ---------------------------------------------------------------------------
SITE_URL=http://127.0.0.1:8000

# Backend usado quando NAO ha configuracao no Admin. Em desenvolvimento o
# console basta (o e-mail aparece no terminal). Em producao:
#   django.core.mail.backends.smtp.EmailBackend
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# Credenciais SMTP (so fazem falta com o backend smtp acima)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=10

DJANGO_DEFAULT_FROM_EMAIL=JD PRINT <nao-responda@jd-print.com>
# Remetente das mensagens de erro que o Django envia aos ADMINS. Se ficar
# vazio, o Django usa o DJANGO_DEFAULT_FROM_EMAIL acima.
DJANGO_SERVER_EMAIL=
EMAIL_VERIFICATION_TIMEOUT=86400
EMAIL_VERIFICATION_RESEND_INTERVAL=120
EMAIL_VERIFICATION_IP_INTERVAL=60
ACCOUNT_EMAIL_IP_LIMIT=5
PASSWORD_RESET_TIMEOUT=86400

# Cookies e HTTPS (o padrao acompanha o DEBUG; em producao HTTPS deixe True)
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SESSION_COOKIE_AGE=1209600

# Origens confiaveis para o CSRF. Obrigatorio em producao: sem isto, todo POST
# do site publicado e recusado. Lista separada por virgula, COM o esquema.
# Ex.: https://seuusuario.pythonanywhere.com,https://jd-print.com
DJANGO_CSRF_TRUSTED_ORIGINS=

# Confiar no cabecalho X-Forwarded-Proto do proxy da hospedagem (necessario no
# PythonAnywhere; ver o comentario em config/settings.py). Deixe False apenas
# se o Django estiver exposto direto, sem proxy na frente.
SECURE_PROXY_SSL_HEADER=True

# Redirecionar HTTP -> HTTPS pelo Django. No PythonAnywhere prefira deixar
# False e ligar o "Force HTTPS" na aba Web: o proxy corta antes do Python.
SECURE_SSL_REDIRECT=True
# HSTS: por quantos segundos o navegador deve LEMBRAR de so acessar via HTTPS.
# Comece baixo (ex.: 300) para testar; so aumente quando tiver certeza de que
# o HTTPS do dominio esta correto. O navegador respeita o prazo mesmo que voce
# desligue o HTTPS depois -- e a razao de nao comecar com 30 dias.
SECURE_HSTS_SECONDS=2592000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# Preload: pedir aos navegadores que ja venham "so HTTPS" antes da primeira
# visita. Praticamente IRREVERSIVEL (sair da lista leva meses). Deixe False
# ate ter o dominio definitivo com HTTPS estavel.
SECURE_HSTS_PRELOAD=False

# Pedidos e frete
ORDER_NUMBER_PREFIX=JD
STORE_COUNTRY=BE
STORE_CURRENCY=EUR
# Para onde vai o e-mail administrativo de cada pedido (lista separada por virgula)
ORDER_ADMIN_EMAILS=pedidos@jd-print.com

# Pagamento (Stripe). Pegue as chaves em https://dashboard.stripe.com/apikeys
# e o segredo do webhook em https://dashboard.stripe.com/webhooks
# Em desenvolvimento: stripe listen --forward-to 127.0.0.1:8000/pagamento/stripe/webhook/
PAYMENT_PROVIDER=stripe
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SESSION_EXPIRES_IN=1800

# ---------------------------------------------------------------------------
# Log
#
# Com DEBUG=False nao existe pagina de erro: sem log, uma falha de e-mail ou de
# webhook desaparece. O diretorio esta no .gitignore.
# ---------------------------------------------------------------------------
DJANGO_LOG_DIR=logs
DJANGO_LOG_LEVEL=INFO
